POSTGRES_DB=study_track
POSTGRES_USER=study_track
POSTGRES_PASSWORD=admin
POSTGRES_HOST_PORT=5432
FRONTEND_ORIGIN=http://localhost:4201
APP_CURRENT_USER_ID=1
APP_LOG_LEVEL=INFO
# Zone for "today" (due flashcards, streaks); blank = the server's zone
APP_TIME_ZONE=America/Chicago
# Host folder for uploaded images (mounted into the container)
MEDIA_HOST_DIR=./data/media
MEDIA_MAX_IMAGE_BYTES=5242880
# Imports (Phase 5). Keys stay here or in the environment, never in git or the database.
LLM_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Ollama on the host, as seen from the container
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
IMPORT_MAX_FILE_BYTES=20971520
