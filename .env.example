POSTGRES_DB=study_track
POSTGRES_USER=study_track
POSTGRES_PASSWORD=admin
POSTGRES_HOST_PORT=5432
FRONTEND_ORIGIN=http://localhost:4201
APP_CURRENT_USER_ID=1
APP_LOG_LEVEL=INFO
# Zone for "today" (due flashcards, streaks); blank = the server's zone
APP_TIME_ZONE=America/Chicago
# Host folder for uploaded images (mounted into the container)
MEDIA_HOST_DIR=./data/media
MEDIA_MAX_IMAGE_BYTES=5242880
# Unused images are deleted daily once they are this old (MEDIA_CLEANUP_CRON=- turns it off).
MEDIA_CLEANUP_GRACE=P7D
# Imports (Phase 5). Keys stay here or in the environment, never in git or the database.
LLM_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Groq (free tier available): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama on the host, as seen from the container
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
IMPORT_MAX_FILE_BYTES=20971520
# Fill an empty catalog (tracks, subjects, topics) from src/main/resources/catalog/*.csv at startup
CATALOG_SEED_ON_STARTUP=true
# Admin pre-fill of the catalog's AI explanations (free API keys allow few requests per minute)
EXPLANATION_PREFILL_PAUSE=PT4S
EXPLANATION_PREFILL_FAILURE_PAUSE=PT30S
EXPLANATION_MAX_CONSECUTIVE_FAILURES=5
